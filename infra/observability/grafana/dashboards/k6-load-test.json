      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_active_handles_total{job=\"bitrate-api\"}",
          "legendFormat": "handles",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_active_requests_total{job=\"bitrate-api\"}",
          "legendFormat": "requests",
