# Off-site backup target (Cloudflare R2). Copy to infra/k8s/backup/.env (gitignored), fill
# in, then create the Secret the backup CronJobs read:
#   task k8s:backup:secret
# The CronJobs read the Secret on every run, so changing it needs no restart.

# https://<ACCOUNT_ID>.r2.cloudflarestorage.com — R2 → Overview → S3 API
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=bitrate-backups
# rclone provider name; Cloudflare for R2
BACKUP_S3_PROVIDER=Cloudflare
# R2 → Manage API tokens → "Object Read & Write", limited to the bucket above
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Encrypts the database backups. Losing it makes every backup unreadable: keep a copy
# outside this machine and outside R2 (a password manager). Generate: openssl rand -base64 32
RESTIC_PASSWORD=
