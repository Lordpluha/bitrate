# Local k3d cluster only (task k8s:cluster). Copy to infra/k8s/.env (gitignored); kustomize
# turns it into the `bitrate-env` Secret every app pod reads. Dev-only values, in the spirit of
# admin/admin in infra/docker-compose.dev.yaml — never reuse them anywhere real.

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=bitrate
DATABASE_URL=postgresql://admin:admin@postgres:5432/bitrate

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# At least 32 characters: openssl rand -base64 48
JWT_SECRET=local-k3d-jwt-secret-change-me-0000000000000000

# SeaweedFS in the cluster; the keys are written into its JSON identity file, so letters and
# digits only (the secret at least 24 characters).
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=bitrate-audio
S3_ACCESS_KEY=bitrateDevAccessKey
S3_SECRET_KEY=bitrateDevSecretKeyChangeMe0001
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1

# production: the cluster runs the production images, so mail must be configured — Mailpit
# captures it at http://mail.bitrate.localhost.
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
AUDIO_PROCESSING_WORKER_ENABLED=false
DEV_MAIL_LOG_TOKENS=false
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@bitrate.localhost

WEB_HOST=http://bitrate.localhost
USER_WEB_HOST=http://bitrate.localhost
ARTIST_WEB_HOST=http://artists.bitrate.localhost
ADMIN_WEB_HOST=http://admin.bitrate.localhost
API_BASE_URL=http://api.bitrate.localhost
COOKIE_DOMAIN=.bitrate.localhost
