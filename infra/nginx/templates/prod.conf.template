# Production entrypoint. Rendered by the nginx image's entrypoint, which substitutes ${DOMAIN}
# from the container environment into /etc/nginx/conf.d/ before nginx starts.
#
# Certificates come from certbot on the host, mounted read-only at /etc/letsencrypt.
# See apps/docs/docs/infrastructure/deployment.md for how to issue them the first time.

include /etc/nginx/snippets/upstreams.conf;

# HTTP: serves the ACME challenge, sends everything else to HTTPS.
server {
    # default_server, so this block owns port 80 regardless of include order. The image ships its
    # own conf.d/default.conf, which sorts before prod.conf and was therefore answering every
    # unrecognised Host with the stock welcome page — and, worse, swallowing ACME challenges for
    # any name not listed below, which is exactly when a new subdomain's first certificate fails.
    listen 80 default_server;
    # admin.${DOMAIN} is deliberately absent: it is served only through the Cloudflare tunnel
    # (see the operator panel's internal listener below), never from the public ports.
    server_name ${DOMAIN} www.${DOMAIN} artists.${DOMAIN} api.${DOMAIN} docs.${DOMAIN} ui.${DOMAIN};

    # Must stay reachable over plain HTTP — certbot renews through it.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        # $host, not ${DOMAIN}: artists.${DOMAIN} must land on itself over HTTPS, not on the apex.
        return 301 https://$host$request_uri;
    }
}

# www redirects to the apex, so the site has one canonical address. Certbot must issue the
# certificate for both names or this block cannot present a valid one.
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 301 https://${DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Two years, and only here: sending HSTS over plain HTTP is meaningless, and a wrong
    # max-age is not something a browser lets you take back.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    include /etc/nginx/snippets/app-routes.conf;
}

# Artists portal on its own host. Same certificate — it covers every name issued for this site,
# so certbot must be given artists.${DOMAIN} too.
server {
    listen 443 ssl;
    http2 on;
    server_name artists.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    include /etc/nginx/snippets/artists-routes.conf;
}

# Operator panel. Reachable ONLY through the Cloudflare tunnel, which puts Cloudflare Access in
# front of it: the tunnel's public hostname admin.${DOMAIN} points at http://nginx:8081.
#
# It used to be a `listen 443` block here, which made the panel and admin-api answer anyone who
# sent Host: admin.${DOMAIN} straight to the server's IP -- Access was never in that path. 8081 is
# not published in docker-compose.prod.yaml, so only containers on bitrate-network reach it.
# Plain HTTP is fine: TLS terminates at Cloudflare and this hop never leaves the docker bridge.
server {
    listen 8081;
    server_name admin.${DOMAIN};

    # Every request arrives from the cloudflared container. Without this, $remote_addr is that
    # one address for everybody: admin_auth_limit becomes one shared bucket (a few bad logins
    # lock every operator out) and admin-api audits the tunnel instead of the client. The
    # header is trusted only from private addresses, i.e. from inside the docker network --
    # the only place this listener can be reached from.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header CF-Connecting-IP;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # DENY, not SAMEORIGIN: nothing should ever frame the operator panel.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    include /etc/nginx/snippets/admin-routes.conf;
}

# API on its own host. There is no path route to it any more — one host, one application.
server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    include /etc/nginx/snippets/api-routes.conf;
}

# Documentation site — a Docusaurus build served by nginx inside its own container.
server {
    listen 443 ssl;
    http2 on;
    server_name docs.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    set $static_upstream http://docs:8080;
    include /etc/nginx/snippets/static-site-routes.conf;
}

# Storybook — the composed component catalogue: @bitrate/ui-react at /, with the player at
# /player/ and the admin UI kit at /admin/ served from the same container (one origin, so the
# host Storybook reads the other two as refs without CORS).
server {
    listen 443 ssl;
    http2 on;
    server_name ui.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    set $static_upstream http://storybook:8080;
    include /etc/nginx/snippets/static-site-routes.conf;
}
