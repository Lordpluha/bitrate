import { cva, type VariantProps } from 'class-variance-authority'
import { forwardRef, type HTMLAttributes } from 'react'

import { cn } from '@/lib/utils'

export const __NameCamel__Variants = cva('', {
  variants: {
    tone: {
      default: '',
    },
  },
  defaultVariants: { tone: 'default' },
})

export type __NamePascal__Props = HTMLAttributes<HTMLDivElement> &
  VariantProps<typeof __NameCamel__Variants>

export const __NamePascal__ = forwardRef<HTMLDivElement, __NamePascal__Props>(
  ({ className, tone, ...props }, ref) => (
    <div
      className={cn(__NameCamel__Variants({ tone }), className)}
      data-testid="__NameKebab__"
      ref={ref}
      {...props}
    />
  ),
)

__NamePascal__.displayName = '__NamePascal__'
