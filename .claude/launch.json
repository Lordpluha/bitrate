{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bitrate/api", "start:dev"],
      "port": 3000
    },
    {
      "name": "web-player",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bitrate/web-player", "dev"],
      "port": 3001
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bitrate/docs", "start"],
      "port": 3003
    },
    {
      "name": "docs-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bitrate/docs", "exec", "docusaurus", "serve", "--port", "3004"],
      "port": 3004
    }
  ]
}
