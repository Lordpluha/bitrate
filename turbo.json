{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["biome.json", ".npmrc"],
  "globalPassThroughEnv": ["SKIP_GRAPHIFY_INSTALL", "SKIP_RTK_INSTALL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**", ".docusaurus/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**", "!**/__screenshots__/**"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**", "!**/__screenshots__/**"],
      "outputs": []
    },
    "dev": {
      "cache": false
    }
  }
}
