{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NG_APP_API_URL"],
  "globalDependencies": ["biome.json", ".npmrc"],
  "globalPassThroughEnv": [
    "SKIP_GRAPHIFY_INSTALL",
    "SKIP_RTK_INSTALL",
    "NO_COLOR",
    "DATABASE_URL",
    "SHADOW_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        ".docusaurus/**",
        ".output/**"
      ],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "API_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "ENFORCE_DEPLOY_ENV",
        "VITE_API_URL"
      ],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN", "SENTRY_RELEASE"]
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**", "!**/__screenshots__/**"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["coverage/**"]
    },
    "format": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["generate-types"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**", "!**/__screenshots__/**"],
      "outputs": []
    },
    "generate-types": {
      "dependsOn": ["^generate-types"],
      "outputs": [".types-refs/**"]
    },
    "@bitrate/web-player#generate-types": { "outputs": [] },
    "@bitrate/web-artists#generate-types": { "outputs": [] },
    "@bitrate/api#generate-types": { "outputs": [] },
    "@bitrate/admin#generate-types": { "outputs": [] },
    "dev": {
      "cache": false
    }
  }
}
