    {
      "type": "frame",
      "id": "yapmJ",
      "x": 56000,
      "y": 12640,
      "name": "Product Note / Logic — Analytics overview",
      "width": 1440,
      "height": 160,
      "fill": "$color-background-tinted",
      "cornerRadius": 18,
      "stroke": "$color-border",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 10,
      "padding": [
        22,
        26
      ],
      "children": [
        {
          "type": "text",
          "id": "pvGH9",
          "name": "RU Note / Title",
          "fill": "$color-accent",
          "content": "Logic — Analytics overview",
          "fontFamily": "$font-body",
          "fontSize": 16,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "lC2mb",
          "name": "RU Note / Body",
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 1388,
          "content": "The overview answers one question: how confirmed signals change within Bitrate. Every metric includes definition, source, period, timezone, and update time. External services are not mixed into values and appear as Not connected rather than zero. Charts include a legend, value labels, and a tabular alternative.",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "Ik21q",
      "x": 58000,
      "y": 12640,
      "name": "Product Note / Logic — Release / track drill-down",
      "width": 1440,
      "height": 160,
      "fill": "$color-background-tinted",
      "cornerRadius": 18,
      "stroke": "$color-border",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 10,
      "padding": [
        22,
        26
      ],
      "children": [
        {
          "type": "text",
          "id": "k1B5U",
          "name": "RU Note / Title",
          "fill": "$color-accent",
          "content": "Logic — Release / track drill-down",
          "fontFamily": "$font-body",
          "fontSize": 16,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "mCab1",
          "name": "RU Note / Body",
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 1388,
          "content": "Selecting a release or track updates every card, table, and source breakdown in one context. Period comparisons require the same duration, source, and timezone. Completion is defined explicitly; demo data covers Bitrate only and does not imply external integrations.",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "G77Pu",
      "x": 60000,
      "y": 12640,
      "name": "Product Note / Logic — Analytics data states",
      "width": 1440,
      "height": 160,
      "fill": "$color-background-tinted",
      "cornerRadius": 18,
      "stroke": "$color-border",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 10,
      "padding": [
        22,
        26
      ],
      "children": [
        {
          "type": "text",
          "id": "JhQdG",
          "name": "RU Note / Title",
          "fill": "$color-accent",
          "content": "Logic — Analytics data states",
          "fontFamily": "$font-body",
          "fontSize": 16,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "UQhpc",
          "name": "RU Note / Body",
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 1388,
          "content": "Observed zero is a measured zero for a defined window. No data yet means there are not enough events. Delayed preserves the last known value and reports freshness. Load error preserves filters and offers Retry. Revenue and forecasts remain future concepts: facts and estimates are separated, and a forecast is never presented as a guarantee.",
          "lineHeight": 1.45,
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
