          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "cF5ku",
          "x": 748,
          "y": 62,
          "name": "Logic / Delivery plan / B",
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 640,
          "content": "Destinations distinguish Not connected, Pending, and Unavailable. An unavailable capability is never hidden behind an unexplained disabled button.",
          "fontFamily": "$font-body",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
