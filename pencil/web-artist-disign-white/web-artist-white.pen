      "children": [
        {
          "type": "text",
          "id": "NNM23",
          "name": "Note / Title",
          "fill": "#93C5FD",
          "content": "Logic / Track, Release and release types",
          "fontFamily": "$font-body",
          "fontSize": 16,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "GHa0T",
          "name": "Note / Body",
          "fill": "#E5E7EB",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A Track is one audio recording and its versions. A Release is the publication container: track list, artwork, title, contributors, rights, date, and status. A Single focuses on one primary track, an EP is a short multi-track release, and an Album is a larger cohesive track list.\nExact count and duration limits depend on the destination. The design does not invent them; requirements appear after a confirmed delivery service is selected.",
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
