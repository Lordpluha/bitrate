    {
      "type": "frame",
      "id": "x6HSxe",
      "x": 72000,
      "y": 13000,
      "name": "Note / Global Search Logic",
      "width": 1440,
      "height": 180,
      "fill": "#151923",
      "cornerRadius": 14,
      "stroke": "#7C3AED",
      "strokeWidth": 1,
      "layout": "none",
      "children": [
        {
          "type": "text",
          "id": "zoJ6C",
          "x": 24,
          "y": 20,
          "name": "Search Note / Title",
          "fill": "#C4B5FD",
          "content": "LOGIC · GLOBAL SEARCH",
          "fontFamily": "$font-body",
          "fontSize": 11,
          "fontWeight": "normal",
          "letterSpacing": 1.3
        },
        {
          "type": "text",
          "id": "MMSDF",
          "x": 24,
          "y": 52,
          "name": "Search Note / Body",
          "fill": "#D1D5DB",
          "textGrowth": "fixed-width",
          "width": 1392,
          "content": "Search covers releases, tracks, campaigns, tasks, and settings. Every result retains its type, source, and natural action. Query and scope remain visible after selection; keyboard hints specify future behavior. Selected preview does not replace navigation. Demo results do not prove backend search exists.",
          "lineHeight": 1.4,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "ZVIAP",
      "x": 74000,
      "y": 12600,
      "name": "Note / Notification Center Logic",
      "width": 1440,
      "height": 180,
      "fill": "#151923",
      "cornerRadius": 14,
      "stroke": "#7C3AED",
      "strokeWidth": 1,
      "layout": "none",
      "children": [
        {
          "type": "text",
          "id": "VENMX",
          "x": 24,
          "y": 20,
          "name": "Notifications Note / Title",
          "fill": "#C4B5FD",
          "content": "LOGIC · NOTIFICATION CENTER",
          "fontFamily": "$font-body",
          "fontSize": 11,
          "fontWeight": "normal",
          "letterSpacing": 1.3
        },
        {
          "type": "text",
          "id": "sltEU",
          "x": 24,
          "y": 52,
          "name": "Notifications Note / Body",
          "fill": "#D1D5DB",
          "textGrowth": "fixed-width",
          "width": 1392,
          "content": "A notification shows the event, object, time, and next step. Action required is separated from ordinary updates; unread state does not rely on color alone, and Mark all as read does not delete history. Draft saved states that nothing was published; Approved refers to Bitrate review, not external delivery. Channels and security policy depend on implementation.",
          "lineHeight": 1.4,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "m2zgI",
      "x": 76000,
      "y": 12540,
      "name": "Note / Context Actions Logic",
      "width": 1440,
      "height": 190,
      "fill": "#151923",
      "cornerRadius": 14,
      "stroke": "#7C3AED",
      "strokeWidth": 1,
      "layout": "none",
      "children": [
        {
          "type": "text",
          "id": "oGaSJ",
          "x": 24,
          "y": 20,
          "name": "Context Actions Note / Title",
          "fill": "#C4B5FD",
          "content": "LOGIC · CONTEXT ACTIONS",
          "fontFamily": "$font-body",
          "fontSize": 11,
          "fontWeight": "normal",
          "letterSpacing": 1.3
        },
        {
          "type": "text",
          "id": "SLNTw",
          "x": 24,
          "y": 52,
          "name": "Context Actions Note / Body",
          "fill": "#D1D5DB",
          "textGrowth": "fixed-width",
          "width": 1392,
          "content": "Actions depend on object lifecycle: a draft can be deleted after confirmation, a review can be withdrawn while preserving files, and a published item can be archived while preserving workspace and history. Permanent delete is separate from routine actions and unavailable in invalid states. Mobile uses a bottom sheet. Focus, Escape, click-away, and focus return require runtime verification.",
          "lineHeight": 1.4,
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
