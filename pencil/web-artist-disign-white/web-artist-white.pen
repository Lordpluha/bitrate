      "gap": 10,
      "padding": 20,
      "children": [
        {
          "type": "text",
          "id": "a52Ttw",
          "name": "Annotation / Title",
          "fill": "#93C5FD",
          "content": "Logic / Mobile navigation",
          "fontFamily": "$font-body",
          "fontSize": 16,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "ZzHDY",
          "name": "Annotation / Logic",
          "fill": "#E5E7EB",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The menu opens above the page. The close button, Escape, and backdrop dismiss it.\nFocus remains inside the menu and returns to its trigger; the page behind it does not scroll.\nStatic states communicate intent; interaction is not implemented here.",
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
