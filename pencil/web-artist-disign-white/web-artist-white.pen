        },
        {
          "type": "text",
          "id": "LNPD8",
          "x": 28,
          "y": 62,
          "name": "Logic / Column 1",
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 650,
          "content": "A required change blocks resubmission. A reply is saved separately from the resolved state; the artist must understand what fix is expected and where to make it.",
          "fontFamily": "$font-body",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "rfcAs",
          "x": 748,
          "y": 62,
          "name": "Logic / Column 2",
          "fill": "$color-text-secondary",
          "textGrowth": "fixed-width",
          "width": 650,
          "content": "A recommendation does not block the release; it can be completed or dismissed. Resubmit for review appears after every required item is resolved. Errors do not erase replies or fixes.",
          "fontFamily": "$font-body",
          "fontSize": 11,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "U4wbsb",
          "x": 28,
          "y": 128,
          "name": "Logic / Constraint",
          "fill": "$color-warning",
          "textGrowth": "fixed-width",
          "width": 1370,
          "content": "Resubmission returns the release to internal Bitrate review only; it is not approval, publication, or external delivery.",
          "fontFamily": "$font-body",
          "fontSize": 10,
          "fontWeight": "normal"
        }
      ]
    },
