        },
        {
          "type": "text",
          "id": "boTN4",
          "name": "Annotation / Logic",
          "fill": "#E5E7EB",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A new artist sees an empty state and one clear action: create the first release. The draft can be completed later.\nSearch and notifications are shared workspace elements. Navigation persists across sections.\nAll application copy is English. These notes support discussion and are not part of the interface.",
          "fontFamily": "$font-body",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
    {
      "type": "frame",
      "id": "WlJKT",
