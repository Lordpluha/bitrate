      "children": [
        {
          "type": "text",
          "id": "dyfHY",
          "x": 24,
          "y": 20,
          "name": "QA Note / Title",
          "fill": "#C4B5FD",
          "content": "LOGIC · STATIC QA MATRIX",
          "fontFamily": "$font-body",
          "fontSize": 11,
          "fontWeight": "normal",
          "letterSpacing": 1.4
        },
        {
          "type": "text",
          "id": "m3awa",
          "x": 24,
          "y": 52,
          "name": "QA Note / Body",
          "fill": "#D1D5DB",
          "content": "The matrix specifies visual parity across Dark, Light, and Dim; Default, Hover, Focus, Pressed, and Disabled; plus long-title, missing-artwork, empty, loading, recoverable-error, and success cases. Status color is reinforced by a label or icon. This is an implementation handoff, not proof of keyboard behavior, measured contrast, motion, or responsive runtime; those checks remain open.",
          "fontFamily": "$font-body",
          "fontSize": 13,
          "fontWeight": "normal"
        }
      ]
    },
