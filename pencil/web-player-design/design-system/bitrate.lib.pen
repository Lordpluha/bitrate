        {
          "type": "frame",
          "id": "OMpta",
          "name": "Semantic Roles / Theme Demonstration",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 13,
          "children": [
            {
              "type": "text",
              "id": "R9yUY6",
              "name": "Theme Demo / Title",
              "fill": "$--foreground",
              "content": "One meaning. Three themes.",
              "fontFamily": "$--font-heading",
              "fontSize": 24,
              "fontWeight": "500"
