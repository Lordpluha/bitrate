  "children": [
    {
      "type": "frame",
      "id": "TzwhT",
      "x": 0,
      "y": 0,
      "name": "00 • Component Masters",
      "theme": {
        "Mode": "Dark"
      },
      "clip": true,
      "width": 1440,
      "height": 760,
      "fill": "$--background",
      "layout": "vertical",
      "gap": 32,
      "padding": 48,
      "children": [
        {
          "type": "frame",
          "id": "CoMwH",
          "name": "Masters Header",
          "width": "fill_container",
          "justifyContent": "space_between",
          "alignItems": "end",
          "children": [
            {
              "type": "frame",
              "id": "qXERv",
              "name": "Masters Title Group",
              "layout": "vertical",
              "gap": 6,
              "children": [
                {
                  "type": "text",
                  "id": "F9qH1B",
