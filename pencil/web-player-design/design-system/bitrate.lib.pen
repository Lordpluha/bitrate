              "fontFamily": "$--font-sans",
              "fontSize": 12,
              "fontWeight": "600",
              "letterSpacing": 1.4
            },
            {
              "type": "frame",
              "id": "TSdXy",
              "name": "Button Masters Row",
              "width": "fill_container",
              "gap": 16,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "BP7Z8",
                  "name": "Button/Default",
                  "reusable": true,
                  "height": 44,
                  "fill": "$--primary",
                  "cornerRadius": "$--radius-full",
                  "gap": 9,
                  "padding": [
                    0,
                    18
                  ],
                  "justifyContent": "center",
                  "alignItems": "center",
                  "children": [
                    {
                      "type": "icon",
                      "id": "R25rik",
                      "name": "Button / Primary Icon",
                      "width": 17,
                      "height": 17,
