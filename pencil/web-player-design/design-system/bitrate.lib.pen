                  "fill": "$--accent",
                  "content": "BITRATE / CORE LIBRARY",
                  "fontFamily": "$--font-sans",
                  "fontSize": 12,
                  "fontWeight": "600",
                  "letterSpacing": 1.6
                },
                {
                  "type": "text",
                  "id": "XLJMr",
                  "name": "Masters Title",
                  "fill": "$--foreground",
                  "content": "Reusable masters",
                  "lineHeight": 1,
                  "fontFamily": "$--font-heading",
                  "fontSize": 40,
                  "fontWeight": "600"
                }
              ]
            },
            {
              "type": "text",
              "id": "Lgc8S",
              "name": "Masters Note",
              "fill": "$--muted-foreground",
              "content": "Edit once → propagate everywhere",
              "fontFamily": "$--font-sans",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
