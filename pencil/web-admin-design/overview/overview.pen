      "children": [
        {
          "type": "frame",
          "id": "xEmywf",
          "name": "Notes",
          "layout": "vertical",
          "gap": 16,
          "width": "fill_container",
          "padding": 64,
          "children": [
            {
              "type": "ref",
              "id": "hHAv4G",
              "ref": "admin:MgMQ2L",
              "name": "Text/H1",
              "content": "Interaction notes"
            },
            {
              "type": "ref",
              "id": "a8FFwp",
              "ref": "admin:C5Ih8u",
              "name": "Text/Muted",
              "content": "Static frames cannot move; this is what the prototype animates. Prototype: pencil/web-admin-design/prototype/admin-bento-prototype.html."
            },
            {
              "type": "ref",
              "id": "dWrgsT",
              "ref": "admin:zWEMD4",
              "name": "Note / Tile → analysis",
              "width": "fill_container",
              "descendants": {
                "admin:Er85xA": {
                  "content": "Tile → analysis"
                },
                "admin:zDbgFp": {
                  "content": "A tile grows into the analysis panel from its own position (520 ms, ease-out); on phones it rises as a sheet. ← / → step between analyses, Esc or the scrim closes and the panel shrinks back into its tile."
                }
              }
            },
            {
              "type": "ref",
              "id": "gONtwm",
              "ref": "admin:zWEMD4",
              "name": "Note / Chart hover",
              "width": "fill_container",
              "descendants": {
                "admin:Er85xA": {
                  "content": "Chart hover"
                },
                "admin:zDbgFp": {
                  "content": "A crosshair follows the nearest day with a point on each series and a tooltip listing their values; legend chips hide or show a series, Compare adds the previous period."
                }
              }
            },
            {
              "type": "ref",
              "id": "VVmpY1",
              "ref": "admin:zWEMD4",
              "name": "Note / Status island",
              "width": "fill_container",
              "descendants": {
                "admin:Er85xA": {
                  "content": "Status island"
                },
                "admin:zDbgFp": {
                  "content": "The island’s pocket opens for a status — Updating figures with a progress bar, Up to date, a new report, Saved, Test sent — and folds back after a few seconds. While it is open the search narrows instead of being covered."
                }
              }
            },
            {
              "type": "ref",
              "id": "ORmjBH",
              "ref": "admin:zWEMD4",
              "name": "Note / Live reports",
              "width": "fill_container",
              "descendants": {
                "admin:Er85xA": {
                  "content": "Live reports"
                },
                "admin:zDbgFp": {
                  "content": "About every nine seconds a report arrives: the island announces it, it slides into Latest reports and the Moderation count rises."
                }
              }
            },
            {
              "type": "ref",
              "id": "7CrkYO",
              "ref": "admin:zWEMD4",
              "name": "Note / Loading",
              "width": "fill_container",
              "descendants": {
                "admin:Er85xA": {
                  "content": "Loading"
                },
                "admin:zDbgFp": {
                  "content": "Tiles load one by one; each shows a skeleton shaped like its content. Figures count up and bars grow when the data lands."
                }
              }
            },
            {
              "type": "ref",
              "id": "afE4Oj",
              "ref": "admin:zWEMD4",
              "name": "Note / Glass and aurora",
              "width": "fill_container",
              "descendants": {
                "admin:Er85xA": {
                  "content": "Glass and aurora"
                },
                "admin:zDbgFp": {
                  "content": "Tiles are glass over a slow aurora of the brand colours (26–32 s drift); reduced motion stops the drift and every transition."
                }
              }
            },
            {
              "type": "ref",
              "id": "FLNgJe",
              "ref": "admin:zWEMD4",
              "name": "Note / Profile menu",
              "width": "fill_container",
              "descendants": {
                "admin:Er85xA": {
                  "content": "Profile menu"
                },
                "admin:zDbgFp": {
                  "content": "The avatar (island on desktop, top bar on phones) opens the profile menu under it: who is signed in and their role, notification settings, language and theme with their current values, and sign out. Language and theme change in place while the menu stays open; the bell, Escape or a click outside closes it."
                }
              }
            },
            {
              "type": "ref",
              "id": "SeFSnr",
              "ref": "admin:zWEMD4",
              "name": "Note / Phone",
              "width": "fill_container",
              "descendants": {
                "admin:Er85xA": {
                  "content": "Phone"
                },
                "admin:zDbgFp": {
                  "content": "One column; the top bar shows only the logo and the avatar. Every action lives once, in the bottom island tab bar: Overview, Search, Alerts and Menu. The bell opens notifications above the tab bar; its footer leads to notification settings, where the bell tab stays active."
                }
              }
            }
          ]
        }
      ],
