  "children": [
    {
      "type": "frame",
      "id": "C8g14E",
      "name": "Bitrate Artist Design System",
      "x": 0,
      "y": 0,
      "width": 1760,
      "layout": "vertical",
      "gap": 72,
      "padding": 64,
      "fill": [
        {
          "type": "gradient",
          "gradientType": "linear",
          "rotation": 135,
          "colors": [
            {
              "color": "$--artist-canvas-start",
              "position": 0
            },
