              "fontSize": 26,
              "fill": "$--artist-foreground",
              "fontFamily": "$--font-heading",
              "fontWeight": "600",
              "letterSpacing": 0
            },
            {
              "type": "text",
              "id": "L8QUOD",
              "name": "Poppins type at the workspac",
              "content": "Poppins type at the workspace and public-page sizes, the Bitrate mark and lockup, the Google and Facebook marks, avatar, divider, skeleton, spinner and the phone status bar.",
              "fontSize": 14,
              "fill": "$--artist-text-secondary",
              "width": 820,
              "textGrowth": "fixed-width",
              "lineHeight": 1.5,
              "fontFamily": "$--font-sans"
