    {
      "type": "group",
      "id": "zsuwm",
      "x": 9038,
      "y": 5055,
      "name": "Bitrate • Landing / Light Color Edition",
      "context": "Light Color Edition. Separate copy of w4YxPF at x9038/y5055. Ten continuous sections, one global hero header and final footer. Existing light tokens, blue/green/amber/pink chapter accents and purple CTAs. Light 3D tablet is a new raster edit with prompt provenance; original assets and all existing roots/variables unchanged. Snapshot reviewed; three intentional clipped decorative horizons only.",
      "children": [
        {
          "type": "frame",
          "id": "j1urwv",
          "x": 0,
          "y": 0,
          "name": "11 • Bitrate / Header + Hero / V2 / Light",
          "theme": {
            "mode": "light"
          },
          "clip": true,
          "width": 1440,
          "height": 1080,
          "fill": "#FFFFFF",
          "layout": "none",
          "children": [
            {
              "type": "group",
              "id": "PJsE4",
              "x": 24,
              "y": 24,
              "children": [
                {
                  "type": "group",
