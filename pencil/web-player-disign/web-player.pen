                  "x": 0,
                  "y": 0,
                  "children": [
                    {
                      "type": "frame",
                      "id": "rUqtU",
                      "x": 76,
                      "y": 46,
                      "name": "Hero / 3D Tablet Scene",
                      "context": "Light-theme 3D tablet. Image Gen edit of existing approved tablet scene; native editable source retained hidden. Prompt in assets/light-landing-v1/tablet-scene-light.prompt.txt.",
                      "theme": {
                        "mode": "light"
                      },
                      "width": 1340,
                      "height": 1005,
                      "fill": {
                        "type": "image",
