{
  "name": "spotify-clone",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Lordpluha/spotify-clone",
  "author": {
    "email": "vladislavteslyukofficial@gmail.com",
    "name": "Vladyslav Tesliuk",
    "url": "https://github.com/Lordpluha"
  },
  "contributors": [
    {
      "email": "crysisnomad321@gmail.com",
      "name": "Andrey Kalashnikov",
      "url": "https://github.com/andreo-kalashnello"
    }
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/Lordpluha/spotify-clone.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "turbo run format",
    "analyze": "pnpm knip",
    "prepare": "lefthook install",
    "commit": "cz",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset tag",
    "knip": "knip",
    "clean:dist": "find . -type d -name 'dist' -not -path './node_modules/*' -exec rm -rf {} + 2>/dev/null || true",
    "docker:dev": "docker-compose -f infra/docker-compose.preprod.yaml up -d",
    "docker:dev:build": "docker-compose -f infra/docker-compose.preprod.yaml up -d --build",
    "docker:down": "docker-compose -f infra/docker-compose.preprod.yaml down",
    "docker:down:volumes": "docker-compose -f infra/docker-compose.preprod.yaml down -v",
    "docker:logs": "docker-compose -f infra/docker-compose.preprod.yaml logs -f",
    "docker:logs:api": "docker-compose -f infra/docker-compose.preprod.yaml logs -f api",
    "docker:logs:web": "docker-compose -f infra/docker-compose.preprod.yaml logs -f web",
    "docker:logs:admin": "docker-compose -f infra/docker-compose.preprod.yaml logs -f admin",
    "docker:prod": "docker-compose -f infra/docker-compose.prod.yaml up -d",
    "docker:prod:build": "docker-compose -f infra/docker-compose.prod.yaml up -d --build",
    "docker:clean": "docker-compose -f infra/docker-compose.preprod.yaml down -v && docker system prune -af",
    "docker:db:migrate": "docker-compose -f infra/docker-compose.preprod.yaml exec api pnpm --filter @spotify/api run db:migration:start",
    "docker:db:gen": "docker-compose -f infra/docker-compose.preprod.yaml exec api pnpm --filter @spotify/api run db:gen",
    "docker:db:seed": "docker-compose -f infra/docker-compose.preprod.yaml exec api pnpm --filter @spotify/api run seed",
    "docker:db:studio": "docker-compose -f infra/docker-compose.preprod.yaml exec api pnpm --filter @spotify/api run db:ui",
    "docker:manage": "chmod +x infra/docker-manage.sh && ./infra/docker-manage.sh",
    "docker:desktop:dev": "docker-compose -f infra/docker-compose.preprod.yaml --profile desktop up -d",
    "docker:desktop:logs": "docker-compose -f infra/docker-compose.preprod.yaml logs -f desktop",
    "docker:mobile:dev": "docker-compose -f infra/docker-compose.preprod.yaml --profile mobile up -d",
    "docker:mobile:logs": "docker-compose -f infra/docker-compose.preprod.yaml logs -f mobile",
    "docker:mobile:qr": "docker-compose -f infra/docker-compose.preprod.yaml logs mobile | grep 'exp://'"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^25.9.3",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "knip": "^5.88.1",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.4.0",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "~19.2.0",
      "@types/react-dom": "~19.2.0",
      "esbuild": "0.27.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "aws-sdk",
      "better-sqlite3",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
