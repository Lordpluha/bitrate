{
  "name": "bitrate",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Lordpluha/bitrate",
  "author": {
    "email": "vladyslav.tesliuk.official@gmail.com",
    "name": "Vladyslav Tesliuk",
    "url": "https://github.com/Lordpluha"
  },
  "contributors": [
    {
      "email": "crysisnomad321@gmail.com",
      "name": "Andrey Kalashnikov",
      "url": "https://github.com/andreo-kalashnello"
    }
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/Lordpluha/bitrate.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format": "turbo run format",
    "prepare": "lefthook install || true",
    "postinstall": "node scripts/setup-graphify.mjs && node scripts/setup-rtk.mjs",
    "commit": "cz",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset tag",
    "knip": "knip",
    "check:artifacts": "bash scripts/check-repository-artifacts.sh",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "design:tokens": "node scripts/sync-pen-tokens.mjs",
    "check:pen-tokens": "node scripts/sync-pen-tokens.mjs --check",
    "design:pages": "node scripts/pencil-pages/blocks.mjs pencil/web-player-design/design-system/bitrate.lib.pen scripts/pencil-pages/registry.json && node scripts/pencil-pages/run.mjs pencil/web-player-design && node scripts/pencil-pages/run-artist.mjs pencil/web-artist-design",
    "clean:dist": "rimraf --glob \"apps/*/dist\" \"packages/*/dist\"",
    "clean:cache": "rimraf --glob \"apps/*/.next/dev/cache\" \"apps/*/.next/cache\" \".turbo/cache\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^25.9.3",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "knip": "^6.40.0",
    "lefthook": "^2.2.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "version": "0.4.0"
}
