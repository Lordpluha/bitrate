{
  "name": "bitrate",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Lordpluha/bitrate",
  "author": {
    "email": "vladislavteslyukofficial@gmail.com",
    "name": "Vladyslav Tesliuk",
    "url": "https://github.com/Lordpluha"
  },
  "contributors": [
    {
      "email": "crysisnomad321@gmail.com",
      "name": "Andrey Kalashnikov",
      "url": "https://github.com/andreo-kalashnello"
    }
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/Lordpluha/bitrate.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format": "turbo run format",
    "prepare": "lefthook install || true",
    "postinstall": "node scripts/setup-graphify.mjs && node scripts/setup-rtk.mjs",
    "commit": "cz",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset tag",
    "knip": "knip",
    "check:artifacts": "bash scripts/check-repository-artifacts.sh",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "clean:dist": "rimraf --glob \"apps/*/dist\" \"packages/*/dist\"",
    "clean:cache": "rimraf --glob \"apps/*/.next/dev/cache\" \"apps/*/.next/cache\" \".turbo/cache\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.3",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "~19.2.0",
      "@types/react-dom": "~19.2.0",
      "esbuild": "0.27.3"
    },
    "onlyBuiltDependencies": [
      "@compodoc/compodoc",
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/engines",
      "@scarf/scarf",
      "@sentry/node-cpu-profiler",
      "@swc/core",
      "argon2",
      "aws-sdk",
      "better-sqlite3",
      "core-js",
      "esbuild",
      "ffmpeg-static",
      "lefthook",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "openapi-typescript>typescript": "6",
        "tsconfck>typescript": "6",
        "i18next>typescript": "6",
        "@expo/require-utils>typescript": "6"
      }
    }
  }
}
