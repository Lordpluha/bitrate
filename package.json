{
  "name": "bitrate",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/Lordpluha/bitrate",
  "author": {
    "email": "vladislavteslyukofficial@gmail.com",
    "name": "Vladyslav Tesliuk",
    "url": "https://github.com/Lordpluha"
  },
  "contributors": [
    {
      "email": "crysisnomad321@gmail.com",
      "name": "Andrey Kalashnikov",
      "url": "https://github.com/andreo-kalashnello"
    }
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/Lordpluha/bitrate.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format": "turbo run format",
    "prepare": "lefthook install || true",
    "postinstall": "node scripts/setup-graphify.mjs && node scripts/setup-rtk.mjs",
    "commit": "cz",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "changeset tag",
    "knip": "knip",
    "check:artifacts": "bash scripts/check-repository-artifacts.sh",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:env": "node scripts/check-environment.mjs",
    "check:branch-protection": "node scripts/check-branch-protection.mjs",
    "clean:dist": "rimraf --glob \"apps/*/dist\" \"packages/*/dist\"",
    "clean:cache": "rimraf --glob \"apps/*/.next/dev/cache\" \"apps/*/.next/cache\" \".turbo/cache\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.3",
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "~19.2.0",
      "@types/react-dom": "~19.2.0",
      "esbuild": "0.27.3",
      "tar": "^7.5.22",
      "browserslist": "^4.28.9",
      "fast-uri": "^3.1.7",
      "multer": "^2.2.0",
      "nanoid": "^3.3.18",
      "shell-quote": "^1.9.0",
      "socket.io-parser": "^4.2.7",
      "svgo": "^3.3.5",
      "dompurify": "^3.4.14",
      "http-proxy-middleware": "^2.0.10",
      "mermaid": "^11.17.2",
      "qs": "^6.16.0",
      "valibot": "^1.4.2",
      "webpack-dev-server": "^5.2.6",
      "body-parser@1": "^1.20.6",
      "body-parser@2": "^2.3.0",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "undici@6": "^6.28.1",
      "undici@7": "^7.29.1",
      "ajv@8": "^8.20.0",
      "hono": "^4.12.34",
      "mysql2": "^3.23.1",
      "picomatch@4": "^4.0.7",
      "postcss@8": "^8.5.28",
      "sharp": "^0.35.1",
      "uuid@11": "^11.1.1",
      "ws@8": "^8.21.3"
    },
    "onlyBuiltDependencies": [
      "@compodoc/compodoc",
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/engines",
      "@scarf/scarf",
      "@sentry/node-cpu-profiler",
      "@swc/core",
      "argon2",
      "aws-sdk",
      "better-sqlite3",
      "core-js",
      "esbuild",
      "ffmpeg-static",
      "lefthook",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "openapi-typescript>typescript": "6",
        "tsconfck>typescript": "6",
        "i18next>typescript": "6",
        "@expo/require-utils>typescript": "6"
      }
    }
  },
  "version": "1.0.0"
}
