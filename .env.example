# Environment variables для Docker Compose
# Скопируйте этот файл в .env и измените значения

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=bitrate
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# API
API_PORT=3000
DATABASE_URL=postgresql://admin:admin@postgres:5432/bitrate
SHADOW_DATABASE_URL=postgresql://admin:admin@postgres:5432/bitrate_shadow
JWT_SECRET=your_jwt_secret_here
TRUST_PROXY_HOPS=0
HEALTH_CHECK_TIMEOUT_MS=2000
# Keep TRUST_PROXY_HOPS at 0 for direct connections. Set an exact positive hop
# count only when the API is isolated behind a proxy that overwrites X-Forwarded-For.
# When METRICS_TOKEN is unset, /api/v1/metrics is disabled.
# METRICS_TOKEN=replace_with_at_least_32_random_characters

# Web
WEB_PORT=3001
WEB_HOST=http://localhost:3001
# Optional audience-specific frontend origins; both fall back to WEB_HOST.
# USER_WEB_HOST=http://localhost:3001
# ARTIST_WEB_HOST=http://localhost:3002
# --- API addresses ---
# Origin only, no path. The clients append the API's global prefix themselves — apps/api sets
# setGlobalPrefix('api'), and both fetch clients build `${base}/api/v1/…`. Writing the prefix
# here produces /api/api/v1/… and every request 404s.
#
# NEXT_PUBLIC_* are baked into the frontend bundle at build time, so changing one requires
# rebuilding the app, not just restarting it.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Public origin of the web player. Next.js inlines NEXT_PUBLIC_* at BUILD time,
# so this must be set before `next build` — a runtime-only value arrives too late.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Server-side origin the web player uses to reach the API.
API_URL=http://localhost:3000


# Mobile (Expo)
MOBILE_METRO_PORT=8081
MOBILE_DEVTOOLS_PORT=19000
MOBILE_METRO_UI_PORT=19001
MOBILE_WEB_PORT=19006
MOBILE_HOST=192.168.1.100  # Замените на ваш локальный IP для подключения с телефона

# Desktop (Tauri)
DESKTOP_PORT=1420

# SMTP (optional — if not set, password-reset emails are logged to console instead of sent)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=noreply@example.com
# Local development only: explicitly print verification/reset URLs when SMTP
# is unavailable. Validation rejects this flag in production.
# DEV_MAIL_LOG_TOKENS=false
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# OAuth (optional — needed for Google/Facebook login)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_FACEBOOK_APP_ID=
# OAUTH_FACEBOOK_APP_SECRET=
# API_BASE_URL=http://localhost:3000

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Production nginx ---
# The domain the certificate is issued for. nginx will not start without it.
DOMAIN=
