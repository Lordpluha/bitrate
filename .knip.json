{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": [".cz-config.js"],
      "ignore": [".cz-config.js"],
      "ignoreBinaries": ["biome", "playwright"]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.module.ts",
        "src/**/*.unit-spec.ts",
        "src/**/*.int-spec.ts",
        "src/**/*.spec.ts",
        "src/infra/**/*.ts",
        "test/e2e/**/*.e2e-spec.ts",
        "test/jest.setup.ts"
      ],
      "ignoreFiles": ["prisma.config.ts"],
      "prisma": false,
      "ignore": ["src/**/index.ts"]
    },
    "apps/web-artists": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.tsx",
        "src/global.css",
        "src/**/*.unit-spec.ts",
        "src/**/*.unit-spec.tsx",
        "src/**/*.int-spec.ts",
        "src/**/*.int-spec.tsx",
        "src/**/*.screenshot-spec.ts",
        "tests/configs/*.ts",
        "tests/e2e/**/*.e2e-spec.ts"
      ],
      "ignore": ["env.schema.ts", "src/routeTree.gen.ts"]
    },
    "apps/web-player": {
      "entry": [
        "src/app/**/*.tsx",
        "src/app/**/*.ts",
        "src/app/global.css",
        "src/**/*.unit-spec.ts",
        "src/**/*.unit-spec.tsx",
        "src/**/*.int-spec.ts",
        "src/**/*.int-spec.tsx",
        "src/**/*.screenshot-spec.ts",
        "tests/configs/*.ts",
        "tests/e2e/**/*.e2e-spec.ts",
        "scripts/select-playwright-tests.mjs",
        "public/sw.js"
      ],
      "ignore": ["env.schema.ts"],
      "ignoreDependencies": ["sniffler"]
    },
    "packages/ui-react": {
      "entry": [
        "src/index.ts",
        "src/**/index.css",
        "src/**/*.unit-spec.ts",
        "src/**/*.unit-spec.tsx",
        "src/**/*.int-spec.ts",
        "src/**/*.int-spec.tsx",
        "src/**/*.snapshot-spec.ts",
        "src/**/*.snapshot-spec.tsx",
        "src/**/*.screenshot-spec.ts",
        "src/**/*.screenshot-spec.tsx",
        "vitest.config.ts",
        ".storybook/preview.tsx"
      ],
      "ignoreDependencies": ["tsc-alias"],
      "storybook": {
        "config": [".storybook/main.ts"],
        "stories": ["src/**/*.stories.@(ts|tsx|mdx)", "src/**/*.mdx"]
      }
    },
    "apps/admin": {
      "entry": ["src/**/*.unit-spec.ts", "eslint.config.js"],
      "ignore": ["src/**/index.ts", "src/styles.css", "src/app/presentation/ui/**"],
      "ignoreDependencies": ["@spartan-ng/cli", "@bitrate/tailwind"]
    },
    "packages/player": {
      "entry": [
        "src/index.ts",
        "src/contract/index.ts",
        "src/engine/index.ts",
        "src/**/*.unit-spec.ts",
        "src/**/*.node-spec.ts",
        "src/**/*.browser-spec.ts"
      ]
    },
    "apps/docs": {
      "entry": ["src/css/custom.css"],
      "ignoreDependencies": [
        "@easyops-cn/docusaurus-search-local",
        "@easyops-cn/docusaurus-theme-docusaurus-search-local"
      ]
    },
    "apps/mobile": {
      "entry": ["components/**/*.ios.tsx", "hooks/**/*.web.ts"],
      "ignoreBinaries": ["eas"],
      "ignoreDependencies": ["expo-updates"]
    },
    "packages/converter": {
      "entry": ["src/ffmpeg-process.d.ts"]
    },
    "packages/ncs-parser": {
      "entry": ["src/main.ts", "tests/*.test.ts"]
    }
  },
  "ignore": [
    "graphify-out/**",
    ".br-scratch/**",
    ".claude/**",
    "**/*.module.css",
    "**/*.test.tsx",
    "**/dist/**",
    "**/.next/**",
    "**/types/**/*.types.ts",
    "**/node_modules/**"
  ],
  "rules": {}
}
