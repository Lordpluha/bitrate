{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": [".cz-config.js"],
      "ignore": [".cz-config.js"],
      "ignoreBinaries": ["biome"]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.module.ts",
        "src/**/*.unit-spec.ts",
        "src/**/*.int-spec.ts",
        "src/**/*.spec.ts",
        "src/infra/**/*.ts",
        "test/e2e/**/*.e2e-spec.ts",
        "test/jest.setup.ts"
      ],
      "ignoreFiles": ["prisma.config.ts"],
      "prisma": false,
      "ignore": ["src/**/index.ts"]
    },
    "apps/web-artists": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.tsx",
        "src/global.css",
        "src/**/*.unit-spec.ts",
        "src/**/*.unit-spec.tsx",
        "src/**/*.int-spec.ts",
        "src/**/*.int-spec.tsx",
        "src/**/*.screenshot-spec.ts",
        "tests/configs/*.ts",
        "tests/e2e/**/*.e2e-spec.ts"
      ],
      "ignore": ["env.schema.ts", "src/routeTree.gen.ts"]
    },
    "apps/web-player": {
      "entry": [
        "src/app/**/*.tsx",
        "src/app/**/*.ts",
        "src/app/global.css",
        "src/**/*.unit-spec.ts",
        "src/**/*.unit-spec.tsx",
        "src/**/*.int-spec.ts",
        "src/**/*.int-spec.tsx",
        "src/**/*.screenshot-spec.ts",
        "tests/configs/*.ts",
        "tests/e2e/**/*.e2e-spec.ts"
      ],
      "ignore": ["env.schema.ts"]
    },
    "packages/ui-react": {
      "entry": [
        "src/**/index.css",
        "src/**/*.unit-spec.ts",
        "src/**/*.unit-spec.tsx",
        "src/**/*.int-spec.ts",
        "src/**/*.int-spec.tsx",
        "src/**/*.snapshot-spec.ts",
        "src/**/*.snapshot-spec.tsx",
        "src/**/*.screenshot-spec.ts",
        "src/**/*.screenshot-spec.tsx",
        "vitest.config.ts"
      ],
      "ignoreDependencies": ["tsc-alias"]
    },
    "apps/admin": {
      "entry": ["src/**/*.unit-spec.ts", "eslint.config.js"],
      "ignore": ["src/**/index.ts", "src/styles.css", "src/app/shared/ui/**"],
      "ignoreDependencies": ["@spartan-ng/cli", "@bitrate/ui-react"]
    }
  },
  "ignore": [
    "graphify-out/**",
    ".br-scratch/**",
    ".claude/**",
    "**/*.module.css",
    "**/*.stories.tsx",
    "**/*.test.tsx",
    "**/dist/**",
    "**/.next/**",
    "**/types/**/*.types.ts",
    "**/node_modules/**"
  ],
  "rules": {}
}
