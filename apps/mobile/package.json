{
  "name": "@bitrate/mobile",
  "main": "expo-router/entry",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export --platform web",
    "lint": "expo lint",
    "build:dev:android": "eas build --platform android --profile development",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:prod:android": "eas build --platform android --profile production",
    "build:prod:ios": "eas build --platform ios --profile production",
    "build:preview": "eas build --platform all --profile preview",
    "build:prod": "eas build --platform all --profile production",
    "build": "pnpm export",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@types/react": "~19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
