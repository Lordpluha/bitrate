# ══════════ 1. OPTIONAL, NO DEFAULT ══════════
# Only EXPO_PUBLIC_* is inlined into the bundle; anything else stays in the CLI
# process and is invisible to the app. Values here ship in plain text — no secrets.

# addresses — the Bitrate API (default http://localhost:3000; Android emulator: http://10.0.2.2:3000)
#EXPO_PUBLIC_API_URL=http://localhost:3000
# the web player, for pages the app opens in the browser (legal documents)
#EXPO_PUBLIC_WEB_PLAYER_URL=http://localhost:3001
