{
  /* Used only by `pnpm check-types` — never by vite. Resolves `@bitrate/ui-react` and
     `@bitrate/player` via their own "bitrate-typecheck" export condition (see each
     package.json) instead of duplicating app path aliases here. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "customConditions": ["bitrate-typecheck"]
  },
  "references": [
    { "path": "../../packages/ui-react/tsconfig.refs.json" },
    { "path": "../../packages/player/tsconfig.refs.json" }
  ]
}
