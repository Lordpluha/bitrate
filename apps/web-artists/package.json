{
  "name": "@spotify/web-artists",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @spotify/ui-react run build",
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm exec biome lint --write",
    "check-types": "tsc --noEmit",
    "format": "pnpm exec biome format --write",
    "test:firefox": "playwright test --config=playwright.config.ts --project=firefox",
    "test:webkit": "playwright test --config=playwright.config.ts --project=webkit",
    "test:chromium": "playwright test --config=playwright.config.ts --project=chromium",
    "test:all": "playwright test --config=playwright.config.ts --project=chromium --project=firefox",
    "test:ui": "playwright test --config=playwright.config.ts --ui",
    "test:e2e": "playwright test --config=playwright.config.ts --project=chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@spotify/ui-react": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "next": "16.2.9",
    "openapi-fetch": "^0.15.2",
    "openapi-react-query": "^0.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@spotify/contracts": "workspace:*",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
