{
  "name": "@bitrate/web-artists",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @bitrate/ui-react run build",
    "dev": "vite dev --port 3002",
    "build": "vite build",
    "start": "cross-env PORT=3002 node .output/server/index.mjs",
    "lint": "pnpm exec biome lint --error-on-warnings",
    "lint:fix": "pnpm exec biome lint --write",
    "generate-types": "tsc -b tsconfig.check-types.json",
    "check-types": "tsc -b tsconfig.check-types.json",
    "format": "pnpm exec biome format --write",
    "test": "pnpm test:unit && pnpm test:int",
    "test:unit": "vitest run --config=tests/configs/vitest.unit.config.ts",
    "test:int": "vitest run --config=tests/configs/vitest.int.config.ts --passWithNoTests",
    "test:e2e": "playwright test --config=tests/configs/playwright.e2e.config.ts",
    "test:e2e:dashboard": "playwright test --config=tests/configs/playwright.e2e.config.ts --project=dashboard-chromium --project=dashboard-mobile-chrome",
    "test:screenshot": "playwright test --config=tests/configs/playwright.screenshot.config.ts",
    "test:screenshot:update": "playwright test --config=tests/configs/playwright.screenshot.config.ts --update-snapshots"
  },
  "dependencies": {
    "@bitrate/ui-react": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "lucide-react": "^1.53.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-transition-group": "^4.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@bitrate/contracts": "workspace:*",
    "@bitrate/tailwind": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
