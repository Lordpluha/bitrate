{
  "name": "@bitrate/web-artists",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @bitrate/ui-react run build",
    "dev": "vite dev --port 3002",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "pnpm exec biome lint --error-on-warnings",
    "lint:fix": "pnpm exec biome lint --write",
    "check-types": "tsc --noEmit",
    "format": "pnpm exec biome format --write",
    "test": "pnpm test:unit && pnpm test:int",
    "test:unit": "vitest run --project=unit",
    "test:int": "vitest run --project=integration --passWithNoTests"
  },
  "dependencies": {
    "@bitrate/ui-react": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "lucide-react": "^1.18.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "react-transition-group": "^4.4.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@bitrate/contracts": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
