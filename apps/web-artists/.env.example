# ══════════ 1. OPTIONAL, WITH A DEFAULT ══════════
# addresses
VITE_API_URL=http://localhost:3000
# public Bitrate player, for links to released albums
VITE_PLAYER_URL=http://localhost:3001
API_URL=http://localhost:3000
# observability — the `artists` Sentry project, used by both the browser and the SSR server; unset,
# Sentry stays off
#VITE_SENTRY_DSN=
#VITE_SENTRY_ENVIRONMENT=development
# build — only for uploading source maps; never commit it
#SENTRY_AUTH_TOKEN=
# runtime — Vite sets NODE_ENV itself
#NODE_ENV=development
