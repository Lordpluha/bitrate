{
  "name": "@bitrate/admin",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "env:gen": "node scripts/with-env.mjs --generate-only",
    "dev": "node scripts/with-env.mjs serve --host 0.0.0.0",
    "build": "node scripts/with-env.mjs build",
    "start": "node scripts/with-env.mjs serve",
    "lint": "pnpm env:gen && eslint .",
    "lint:fix": "pnpm env:gen && eslint . --fix",
    "format": "prettier --write .",
    "generate-types": "pnpm env:gen && tsc -b tsconfig.check-types.json",
    "check-types": "pnpm env:gen && tsc -b tsconfig.check-types.json",
    "test": "node scripts/with-env.mjs test",
    "test:unit": "node scripts/with-env.mjs test",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "storybook": "ng run admin:storybook",
    "storybook:build": "ng run admin:build-storybook"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@bitrate/player": "workspace:*",
    "@jsverse/transloco": "^8.4.0",
    "@jsverse/transloco-messageformat": "^8.4.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@bitrate/contracts": "workspace:*",
    "@bitrate/tailwind": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@spartan-ng/cli": "^1.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
