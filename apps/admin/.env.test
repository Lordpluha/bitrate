# Operator panel — local configuration.
#
# Copy to .env (gitignored) and fill in. Values are read by scripts/with-env.mjs, which writes
# src/app/infrastructure/http/env.generated.ts before every build, serve, test and typecheck.
#
# Loading order, highest priority first: a real shell variable, then .env.local, then .env.
# Note this is the OPPOSITE of apps/api, where ConfigModule lets the FIRST file in its list win.
#
# Angular bakes these into the bundle at build time — setting them on a running container does
# nothing. CI passes NG_APP_API_URL as a Docker build arg from vars.NEXT_PUBLIC_API_URL.

# Base URL of the Bitrate API. Required by every command.
NG_APP_API_URL=http://localhost:3000

# Port the dev server listens on. Required by `dev` and `start` only.
ADMIN_PORT=3005
