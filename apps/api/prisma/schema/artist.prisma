model ArtistSession {
  id            String @id @default(uuid(7)) @db.Uuid
  artistId      String @db.Uuid
  access_token  String @unique
  refresh_token String @unique

  /// Browser the session signed in from, shown in the artist's active sessions list.
  userAgent  String?
  /// Last sign-in or token refresh; `null` for sessions created before this was tracked.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
  @@index([access_token])
  @@index([refresh_token])
}

model Artist {
  id       String  @id @default(uuid(7)) @db.Uuid
  username String  @unique
  email    String  @unique
  password String?

  bio             String? @db.Text
  avatar          String?
  backgroundImage String?

  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  verified            Boolean   @default(false)
  monthlyListeners    Int       @default(0)
  country             String?
  socials             Json?
  deletedAt           DateTime?

  /// Transactional-email locale, set at registration from Accept-Language. See User.locale.
  locale String @default("en")

  /// Revision of the Terms of Use, Community Guidelines and Privacy Policy accepted at registration, and when. See User.legalVersion.
  legalVersion    String?
  legalAcceptedAt DateTime?

  /// Revision of the Artist Agreement accepted at registration, and when.
  artistAgreementVersion    String?
  artistAgreementAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tracks       Track[]       @relation("PrimaryArtist")
  trackCredits TrackArtist[]
  albums       Album[]
  releases     Release[] @relation("ReleaseOwner")
  notificationState ArtistNotificationState?
  notificationPreference ArtistNotificationPreference?
  trackDrafts  ArtistTrackDraft[]
  releaseCredits ReleaseContributor[]
  genres       ArtistGenre[]

  sessions           ArtistSession[]
  oauthAccounts      ArtistOAuthAccount[]
  passwordResets     ArtistPasswordReset[]
  emailVerifications ArtistEmailVerification[]

  likedBy   UserLikedArtist[]
  followers UserFollowedArtist[]

  @@index([email])
  @@index([username])
  @@index([monthlyListeners(sort: Desc)])
  @@index([deletedAt])
}

model ArtistOAuthAccount {
  id                String @id @default(uuid(7)) @db.Uuid
  artistId          String @db.Uuid
  provider          String
  providerAccountId String

  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([artistId])
}

model ArtistPasswordReset {
  id        String   @id @default(uuid(7)) @db.Uuid
  artistId  String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

model ArtistEmailVerification {
  id        String   @id @default(uuid(7)) @db.Uuid
  artistId  String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}

model UserLikedArtist {
  userId    String   @db.Uuid
  artistId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([artistId])
}

model UserFollowedArtist {
  userId    String   @db.Uuid
  artistId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([artistId])
}

model ArtistGenre {
  artistId String @db.Uuid
  genreId  String @db.Uuid
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
  @@index([genreId])
}
