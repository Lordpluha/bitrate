model Genre {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String   @unique
  description String?  @db.Text
  color       String?
  cover       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tracks  TrackGenre[]
  albums  AlbumGenre[]
  artists ArtistGenre[]
}
