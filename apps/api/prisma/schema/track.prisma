enum TrackProcessingStatus {
  PROCESSING
  READY
  FAILED
}

enum TrackProcessingTrigger {
  UPLOAD
  REPLACE
  REPROCESS
}

enum TrackProcessingAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SUPERSEDED
  STALLED
}

enum TrackProcessingStep {
  CLAIM
  PREPARE_TEMP
  PROGRESSIVE_ENCODE
  HLS_ENCODE
  HLS_VALIDATE
  CMAF_ENCODE
  UPLOAD
  PUBLISH
  CLEANUP
}

enum TrackProcessingErrorCode {
  FFMPEG_EXIT
  FFMPEG_SIGNAL
  TIMEOUT
  INVALID_INPUT
  EMPTY_OUTPUT
  STORAGE
  DATABASE
  STALLED
  UNKNOWN
}

model Track {
  id       String  @id @default(uuid(7)) @db.Uuid
  title    String
  audioUrl String
  cover    String?
  artistId String  @db.Uuid

  duration    Int? // Duration in seconds
  releaseDate DateTime?
  lyrics      String?   @db.Text
  explicit    Boolean   @default(false)
  popularity  Int       @default(0)
  playCount   Int       @default(0)
  isrc        String?   @unique
  previewUrl  String?
  trackNumber Int?
  discNumber  Int       @default(1)
  language    String?
  deletedAt   DateTime?
  /// Listeners see the track only once this has passed; null while its release is publishing or
  /// offline. Defaults to creation time, so tracks uploaded outside a release stay public as soon
  /// as they are READY.
  publishedAt DateTime? @default(now()) @db.Timestamptz(3)

  /// Revision of the Artist Agreement the artist confirmed their rights under at upload, and when.
  /// Null for tracks uploaded before the confirmation was recorded.
  rightsConfirmedVersion String?
  rightsConfirmedAt      DateTime?

  processingStatus     TrackProcessingStatus @default(PROCESSING)
  processingError      String?               @db.Text
  processingAttempts   Int                   @default(0)
  processingStartedAt  DateTime?
  processingFinishedAt DateTime?

  // 1 = legacy HLS pipeline, 2 = single-file CMAF + Range index (ADR-0020).
  // Lets both pipelines coexist while the CMAF path is rolled out.
  playbackVersion   Int  @default(1)
  // Shared by every CMAF rendition of this track; null on legacy tracks.
  fragmentTimescale Int?
  durationTicks     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  audioFiles            TrackFile[]
  processingAttemptsLog TrackProcessingAttempt[]
  albums                AlbumTrack[]
  releases              ReleaseTrack[]
  playlists             PlaylistTrack[]
  likedBy               UserLikedTrack[]
  artists               TrackArtist[]
  genres                TrackGenre[]
  listeningHistory      ListeningHistory[]
  playerStates          PlayerState[]
  queueEntries          PlayerQueueItem[]

  artist Artist @relation("PrimaryArtist", fields: [artistId], references: [id], onDelete: Restrict)

  @@index([artistId])
  @@index([title])
  @@index([releaseDate])
  @@index([popularity(sort: Desc)])
  @@index([playCount(sort: Desc)])
  @@index([deletedAt])
}

model TrackFile {
  id      String  @id @default(uuid(7)) @db.Uuid
  trackId String  @db.Uuid
  format  String // "opus", "ogg", "mp3", "flac", "cmaf"
  bitrate Int // 128, 192, 256, 320
  codec   String? // "opus", "vorbis", "mp3", "mp4a.40.2"
  url     String
  size    Int? // File size in bytes

  // Byte-range playback index. Set only on CMAF renditions (format = "cmaf").
  // initRange covers ftyp+moov and is the MSE initialization segment; sidx is
  // parsed at build time and never served. See ADR-0020.
  initRangeStart Int?
  initRangeEnd   Int?
  // [[startTicks, durationTicks, offset, length], ...] — one entry per fragment.
  fragments      Json?

  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, format, bitrate])
  @@index([trackId])
  @@index([format])
}

// One row per BullMQ attempt of the audio-processing pipeline. Successes are compact;
// failures carry the redacted step/error detail the operator panel needs. Retention is
// pruned on write to the newest 25 rows per track — see ADR-0040.
model TrackProcessingAttempt {
  id             String                 @id @default(uuid(7)) @db.Uuid
  trackId        String                 @db.Uuid
  sourceFileName String // the generation this attempt encoded
  jobId          String
  attempt        Int // 1-based, = job.attemptsMade + 1 at start
  maxAttempts    Int
  trigger        TrackProcessingTrigger

  status          TrackProcessingAttemptStatus @default(RUNNING)
  willRetry       Boolean                      @default(false) // FAILED and BullMQ will try again
  deadLetterJobId String? // set on the exhausted attempt

  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  lastProgress Int       @default(0)

  failedStep TrackProcessingStep?
  stepDetail String? // e.g. "192k" for a per-bitrate step

  errorCode      TrackProcessingErrorCode?
  errorName      String? // constructor name
  errorMessage   String?                   @db.Text // redacted, <= 2 KB
  errorStack     String?                   @db.Text // redacted, <= 8 KB
  retryable      Boolean?
  commandSummary String?                   @db.Text // ffmpeg argv, paths redacted, <= 2 KB
  stderrTail     String?                   @db.Text // redacted, <= 16 KB (last bytes)
  exitCode       Int?
  signal         String?

  inputBytes       Int?
  inputCodec       String?
  inputContainer   String?
  inputBitrateKbps Int?
  inputDurationSec Int?

  workerHost    String
  workerPid     Int
  workerRelease String? // SENTRY_RELEASE, null in dev

  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, startedAt(sort: Desc)])
  @@index([jobId, attempt])
}

model UserLikedTrack {
  userId    String   @db.Uuid
  trackId   String   @db.Uuid
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([trackId])
}

model TrackArtist {
  trackId   String  @db.Uuid
  artistId  String  @db.Uuid
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@unique([trackId, position])
  @@index([artistId])
}

model TrackGenre {
  trackId String @db.Uuid
  genreId String @db.Uuid
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@index([genreId])
}
