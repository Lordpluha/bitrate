model User {
  id       String  @id @default(uuid(7)) @db.Uuid
  username String  @unique
  email    String  @unique
  password String?

  avatar      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  deletedAt           DateTime?

  /// Transactional-email and (future) UI locale, set at registration from Accept-Language.
  /// Never derived from a live request after that — see apps/api/src/infra/mail/templates.
  locale String @default("en")

  /// Revision of the Terms of Use, Community Guidelines and Privacy Policy accepted at registration, and when.
  /// Null for accounts created before acceptance was recorded; they are not asked again yet.
  legalVersion    String?
  legalAcceptedAt DateTime?

  sessions            UserSession[]
  passwordResets      UserPasswordReset[]
  emailVerifications  UserEmailVerification[]
  oauthAccounts       UserOAuthAccount[]
  playlists           Playlist[]
  likedTracks         UserLikedTrack[]
  likedArtists        UserLikedArtist[]
  followedArtists     UserFollowedArtist[]
  likedAlbums         UserLikedAlbum[]
  likedPlaylists      UserLikedPlaylist[]
  listeningHistory    ListeningHistory[]
  playlistTracksAdded PlaylistTrack[]
  following           UserFollow[]            @relation("UserFollowing")
  followers           UserFollow[]            @relation("UserFollowers")
  settings            UserSettings?
  searchHistory       SearchHistory[]
  notifications       Notification[]
  devices             PlayerDevice[]
  playerState         PlayerState?
  subscriptions       Subscription[]
  auditLogs           AuditLog[]
  moderationReports   ModerationReport[]
  savedEpisodes       UserSavedEpisode[]

  @@index([email])
  @@index([username])
}

model UserEmailVerification {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserOAuthAccount {
  id                String @id @default(uuid(7)) @db.Uuid
  userId            String @db.Uuid
  provider          String
  providerAccountId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserPasswordReset {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id            String @id @default(uuid(7)) @db.Uuid
  userId        String @db.Uuid
  access_token  String @unique
  refresh_token String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([access_token])
  @@index([refresh_token])
}

model UserFollow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
}
