model ListeningHistory {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  trackId    String   @db.Uuid
  listenedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, listenedAt(sort: Desc)])
  // Artist analytics read one track's plays in a period and count distinct listeners; this
  // order answers it from the index alone. Its trackId prefix also serves plain track lookups.
  @@index([trackId, listenedAt, userId])
  @@index([listenedAt])
}

model SearchHistory {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  query      String
  entityType String?
  entityId   String?  @db.Uuid
  searchedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt(sort: Desc)])
}
