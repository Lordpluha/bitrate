# Bitrate API — copy to .env and fill in the blanks.
#
# Generated from env.schema.ts, which is the source of truth: the API validates against it at
# startup and refuses to boot on a bad value. Only four entries have no default.

# --- required: the app will not start without these ---
WEB_HOST=
JWT_SECRET=
DATABASE_URL=
REDIS_HOST=

# --- defaulted: shown with the value the schema uses ---
NODE_ENV=local
PORT=3000
TRUST_PROXY_HOPS=0
HEALTH_CHECK_TIMEOUT_MS=2000
STORAGE_DRIVER=local
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=30d
ACCESS_TOKEN_NAME=accesstoken
REFRESH_TOKEN_NAME=refreshtoken
SMTP_PORT=587
DEV_MAIL_LOG_TOKENS=false
REDIS_PORT=6379
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- optional: leave a line out entirely rather than setting it empty,
#     an empty value fails validation where an absent one is accepted ---
# METRICS_TOKEN=
# USER_WEB_HOST=
# ARTIST_WEB_HOST=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_FACEBOOK_APP_ID=
# OAUTH_FACEBOOK_APP_SECRET=
# API_BASE_URL=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# REDIS_PASSWORD=
# SENTRY_DSN=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=
