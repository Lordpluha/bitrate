{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "testEnvironment": "node",
  "maxWorkers": 1,
  "testMatch": ["<rootDir>/modules/**/*.int-spec.ts", "<rootDir>/infra/**/*.int-spec.ts"],
  "transform": {
    "node_modules/@nestjs/.+\\.js$": "<rootDir>/../test/esm-deps.transformer.cjs",
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(@noble|@scure|@otplib|@nestjs)/)"],
  "moduleNameMapper": {
    "^@sentry/nestjs$": "<rootDir>/../test/mocks/sentry-nestjs.ts",
    "^@sentry/nestjs/setup$": "<rootDir>/../test/mocks/sentry-nestjs-setup.ts",
    "^src/(.*)$": "<rootDir>/$1",
    "^@modules/(.*)$": "<rootDir>/modules/$1",
    "^@infra/(.*)$": "<rootDir>/infra/$1",
    "^@common/(.*)$": "<rootDir>/common/$1",
    "^@test/(.*)$": "<rootDir>/../test/$1"
  },
  "setupFiles": ["<rootDir>/../test/jest-int.setup.ts"]
}
