{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "maxWorkers": 1,
  "setupFiles": ["<rootDir>/test/jest.setup.ts"],
  "testMatch": ["<rootDir>/test/e2e/**/*.e2e-spec.ts"],
  "transform": {
    "node_modules/@nestjs/.+\\.js$": "<rootDir>/test/esm-deps.transformer.cjs",
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(@noble|@scure|@otplib|@nestjs)/)"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^@modules/(.*)$": "<rootDir>/src/modules/$1",
    "^@infra/(.*)$": "<rootDir>/src/infra/$1",
    "^@common/(.*)$": "<rootDir>/src/common/$1",
    "^@test/(.*)$": "<rootDir>/test/$1"
  }
}
