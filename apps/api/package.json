{
  "name": "@bitrate/api",
  "version": "0.1.0",
  "description": "",
  "author": "Lordpluha",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "precheck-types": "prisma generate",
    "check-types": "tsc --noEmit",
    "format": "pnpm exec biome format --write",
    "start": "nest start",
    "prestart:dev": "pnpm --filter @bitrate/ncs-parser run build",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "pnpm exec biome lint --error-on-warnings",
    "lint:fix": "pnpm exec biome lint --write",
    "test": "jest --config ./test/jest-unit.json",
    "test:watch": "jest --config ./test/jest-unit.json --watch",
    "test:cov": "jest --config ./test/jest-unit.json --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config ./test/jest-unit.json",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:int": "jest --config ./test/jest-int.json",
    "db:start": "prisma dev",
    "db:migration:reset": "prisma migrate reset --force",
    "test:db:migration:reset": "cross-env DATABASE_URL=postgresql://admin:admin@localhost:5433/bitrate_test SHADOW_DATABASE_URL=postgresql://admin:admin@localhost:5433/bitrate_test_shadow prisma migrate reset --force",
    "db:migration:start": "prisma migrate dev --name init",
    "db:migration:deploy": "prisma migrate deploy",
    "db:gen": "prisma generate",
    "db:gen:prod": "prisma generate",
    "db:ui": "prisma studio",
    "db:seed": "prisma db seed",
    "doc:gen": "pnpm dlx @compodoc/compodoc -p tsconfig.json -s -d docs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.26",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/platform-socket.io": "^11.1.26",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.26",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nestjs": "^10.59.0",
    "@sentry/profiling-node": "^10.59.0",
    "@bitrate/converter": "workspace:*",
    "@bitrate/ncs-parser": "workspace:*",
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "music-metadata": "^11.13.0",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@compodoc/compodoc": "^1.2.1",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.26",
    "@bitrate/contracts": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.41",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^7.0.3",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
