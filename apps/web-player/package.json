{
  "name": "@spotify/web-player",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:debug": "cross-env NODE_OPTIONS=--inspect next dev",
    "build": "next build",
    "build:debug": "rimraf .next node_modules/.cache && cross-env DEBUG=\"next:*,webpack:*,turbo:*\" NODE_OPTIONS=\"--max_old_space_size=8192 --trace-warnings\" pnpm run build",
    "start": "next start",
    "lint": "pnpm exec biome lint --write",
    "check-types": "tsc --noEmit",
    "format": "pnpm exec biome format --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@spotify/ui-react": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/react-transition-group": "^4.4.12",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.40.0",
    "next": "^16.2.9",
    "openapi-fetch": "^0.15.2",
    "openapi-react-query": "^0.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "react-redux": "^9.3.0",
    "react-transition-group": "^4.4.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@spotify/contracts": "workspace:*",
    "@tailwindcss/postcss": "^4.3.1",
    "cross-env": "^7.0.3",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "autoprefixer": "^10.5.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.15",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
