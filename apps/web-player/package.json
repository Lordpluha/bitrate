{
  "name": "@bitrate/web-player",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:debug": "cross-env NODE_OPTIONS=--inspect next dev",
    "build": "next build",
    "build:debug": "rimraf .next node_modules/.cache && cross-env DEBUG=\"next:*,webpack:*,turbo:*\" NODE_OPTIONS=\"--max_old_space_size=8192 --trace-warnings\" pnpm run build",
    "start": "next start",
    "lint": "pnpm exec biome lint --error-on-warnings",
    "lint:fix": "pnpm exec biome lint --write",
    "generate-types": "cross-env NODE_ENV=development next typegen && tsc -b tsconfig.check-types.json",
    "check-types": "cross-env NODE_ENV=development next typegen && tsc -b tsconfig.check-types.json",
    "format": "pnpm exec biome format --write",
    "test": "pnpm test:unit && pnpm test:int",
    "test:unit": "vitest run --config=tests/configs/vitest.config.ts --project=unit",
    "test:int": "vitest run --config=tests/configs/vitest.config.ts --project=integration --passWithNoTests",
    "test:select": "node scripts/select-playwright-tests.mjs",
    "test:e2e": "playwright test --config=tests/configs/playwright.e2e.config.ts",
    "test:screenshot": "playwright test --config=tests/configs/playwright.screenshot.config.ts",
    "test:screenshot:update": "playwright test --config=tests/configs/playwright.screenshot.config.ts --update-snapshots"
  },
  "dependencies": {
    "@bitrate/ui-react": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^11.5.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@bitrate/contracts": "workspace:*",
    "@bitrate/tailwind": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.29",
    "postcss-load-config": "^3.1.4",
    "rimraf": "^6.1.3",
    "sniffler": "0.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
