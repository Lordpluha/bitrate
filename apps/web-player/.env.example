# Bitrate web player — copy to .env.development for local work.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle, so treat them as public.
# Changing one needs a rebuild; editing an env file afterwards will not move it.

# --- required: the app will not start without these ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=

# --- defaulted: shown with the value the schema uses ---
NODE_ENV=local

# --- optional: leave a line out entirely rather than setting it empty,
#     an empty value fails validation where an absent one is accepted ---
# API_URL=
