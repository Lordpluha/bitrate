{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": ".types-refs",
    "tsBuildInfoFile": ".types-refs/tsconfig.refs.tsbuildinfo",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.unit-spec.ts",
    "src/**/*.node-spec.ts",
    "src/**/*.browser-spec.ts",
    "src/**/__tests__/**",
    "src/**/*.stories.ts",
    "src/**/stories/**"
  ]
}
