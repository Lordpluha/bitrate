{
  "name": "@bitrate/player",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/esm/index.js",
    "./dist/esm/element/index.js"
  ],
  "main": "./dist/esm/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "bitrate-typecheck": "./.types-refs/index.d.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./contract": {
      "bitrate-typecheck": "./.types-refs/contract/index.d.ts",
      "types": "./dist/types/contract/index.d.ts",
      "import": "./dist/esm/contract/index.js",
      "default": "./dist/esm/contract/index.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "import": "./dist/esm/engine/index.js",
      "default": "./dist/esm/engine/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check-types": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.spec.json",
    "generate-types": "tsc -b tsconfig.refs.json",
    "test": "vitest run --project=unit --project=node --project=browser",
    "test:unit": "vitest run --project=unit --reporter=verbose",
    "test:node": "vitest run --project=node --reporter=verbose",
    "test:browser": "vitest run --project=browser --reporter=verbose"
  },
  "dependencies": {
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.9.3",
    "@vitest/browser-playwright": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.53.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  }
}
