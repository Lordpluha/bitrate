{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": ".types-refs",
    "tsBuildInfoFile": ".types-refs/tsconfig.refs.tsbuildinfo",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src", "src/global.d.ts"],
  "exclude": [
    "**/*.stories.*",
    "**/*.spec.*",
    "**/*.test.*",
    "**/*.screenshot-spec.*",
    "**/*.snapshot-spec.*",
    "**/*.unit-spec.*",
    "**/*.int-spec.*"
  ]
}
