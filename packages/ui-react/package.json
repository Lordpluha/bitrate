{
  "name": "@spotify/ui-react",
  "version": "0.0.2",
  "private": true,
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./themes.css": {
      "style": "./src/styles/themes.css",
      "default": "./src/styles/themes.css"
    },
    "./src": {
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "pnpm exec biome lint --error-on-warnings",
    "lint:fix": "pnpm exec biome lint --write",
    "format": "pnpm exec biome format --write",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm clean && vite build",
    "dev": "vite build --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run --project=unit --project=integration --project=snapshot",
    "test:watch": "vitest --project=unit --project=integration --project=snapshot",
    "test:unit": "vitest run --project=unit --reporter=verbose",
    "test:int": "vitest run --project=integration --reporter=verbose",
    "test:snapshot": "vitest run --project=snapshot --reporter=verbose",
    "test:snapshot:update": "vitest run --project=snapshot --reporter=verbose --update",
    "test:screenshot": "vitest run --project=screenshot",
    "test:screenshot:update": "vitest run --project=screenshot --update",
    "test:cov": "vitest run --project=unit --project=integration --project=snapshot --coverage"
  },
  "peerDependencies": {
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@spotify/vite-svgr": "workspace:*",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^26.1.0",
    "playwright": "^1.53.1",
    "storybook": "^10.4.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@hookform/resolvers": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4.11.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
