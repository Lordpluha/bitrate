{
  "name": "@spotify/ui-react",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./themes.css": {
      "style": "./src/styles/themes.css",
      "default": "./src/styles/themes.css"
    },
    "./src": {
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "pnpm exec biome lint --write",
    "format": "pnpm exec biome format --write",
    "storybook": "storybook dev -p 6006",
    "clean-build": "rimraf dist",
    "loki:init": "pnpm dlx loki update --reactUri=file:./storybook-static",
    "loki:test": "pnpm dlx loki test --reactUri=file:./storybook-static",
    "clean-svgr": "rimraf src/icons/svgr",
    "storybook:build": "storybook build",
    "gen:tokens": "tokens-generator --tokens ../tokens/tokens.json --output ./src/styles",
    "svgr:build": "react-svgr build -i @spotify/tokens/icons -o src/icons/svgr --variables \"primaryColor,secondaryColor\"",
    "svgr:dev": "react-svgr dev -i @spotify/tokens/icons -o src/icons/svgr --variables \"primaryColor,secondaryColor\"",
    "build": "pnpm clean-build && pnpm svgr:build && react-bundler build",
    "dev": "pnpm clean-build && react-bundler dev",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@spotify/esbuild-bundler": "workspace:*",
    "@spotify/svgr": "workspace:*",
    "@spotify/tokens": "workspace:*",
    "@spotify/tokens-generator": "workspace:*",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-prettier": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "esbuild": "0.27.3",
    "glob": "^13.0.6",
    "loki": "^0.35.1",
    "loki-sb7": "^0.33.0",
    "rimraf": "^6.1.3",
    "storybook": "^10.4.4",
    "tailwindcss": "^4.3.1",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tailwindcss/cli": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4.11.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "loki": {
    "configurations": {
      "chrome.laptop": {
        "target": "chrome.docker",
        "width": 1366,
        "height": 768,
        "deviceScaleFactor": 1,
        "mobile": false
      },
      "chrome.iphone7": {
        "target": "chrome.docker",
        "preset": "iPhone 7"
      }
    }
  }
}
