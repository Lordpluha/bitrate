// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Separator snapshots > matches snapshot — horizontal 1`] = `
<div
  aria-orientation="horizontal"
  class="shrink-0 bg-slate-200 dark:bg-grey-500 h-px w-full"
  data-orientation="horizontal"
  role="none"
/>
`;

exports[`Separator snapshots > matches snapshot — vertical 1`] = `
<div
  aria-orientation="vertical"
  class="shrink-0 bg-slate-200 dark:bg-grey-500 h-full w-px"
  data-orientation="vertical"
  role="none"
/>
`;
