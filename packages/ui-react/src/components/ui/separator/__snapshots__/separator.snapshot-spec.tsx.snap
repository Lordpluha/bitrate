// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Separator snapshots > matches snapshot — horizontal 1`] = `
<div
  aria-orientation="horizontal"
  class="shrink-0 bg-separator-color h-px w-full"
  data-orientation="horizontal"
  role="none"
/>
`;

exports[`Separator snapshots > matches snapshot — vertical 1`] = `
<div
  aria-orientation="vertical"
  class="shrink-0 bg-separator-color h-full w-px"
  data-orientation="vertical"
  role="none"
/>
`;
