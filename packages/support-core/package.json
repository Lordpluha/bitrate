{
  "name": "@bitrate/support-core",
  "version": "0.1.0",
  "description": "Framework-free core of the Bitrate support assistant: conversation engine, knowledge chunking and channel formatting (ADR-0074)",
  "private": true,
  "license": "MIT",
  "author": "Lordpluha",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "format": "biome format --write"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/provider": "^4.0.39",
    "ai": "^7.0.179"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
