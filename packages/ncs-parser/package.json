{
  "name": "@spotify/ncs-parser",
  "version": "0.0.1",
  "private": true,
  "description": "NoCopyrightSounds website parser to provide an API",
  "main": "dist/cjs/main.js",
  "module": "dist/esm/main.js",
  "types": "dist/esm/main.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc --module CommonJS --outDir dist/cjs && tsc --module ESNext --outDir dist/esm",
    "buildWatch": "concurrently \"tsc --watch --module CommonJS --outDir dist/cjs\" \"tsc --watch --module ESNext --outDir dist/esm\"",
    "dev": "concurrently \"pnpm run buildWatch\" \"pnpm run devStart\"",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run format",
    "test": "tsc -p tests/tsconfig.test.json && node --enable_source_maps tests/dist/tests/main.test.js",
    "testCache": "tsc -p tests/tsconfig.test.json && node --enable_source_maps tests/dist/tests/cache.test.js"
  },
  "author": "Lordpluha",
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "jsdom": "^28.1.0"
  },
  "files": [
    "dist"
  ]
}
