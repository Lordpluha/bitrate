{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "skipLibCheck": true
  },
  "include": ["./src"],
  "exclude": ["node_modules", "dist", "tests"]
}
